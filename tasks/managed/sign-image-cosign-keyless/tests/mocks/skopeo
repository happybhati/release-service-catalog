#!/usr/bin/env bash
# Mock skopeo executable for Tekton task tests.
# Returns manifest JSON based on the image reference in the last argument.
# Strips --retry-times N from logged args so existing assertions stay compatible
# with the Python skopeo helper, which always adds that flag.

_TEST_MANIFEST_LIST_OCI_REFERENCE="quay.io/redhat-user-workloads/test-product/test-image0@sha256:0000"
_TEST_MANIFEST_LIST_REFERENCE="quay.io/redhat-user-workloads/test-product/test-image1@sha256:1111"

NORMALIZED_ARGS=()
SKIP_NEXT=0
for ARG in "$@"; do
    if [ "${SKIP_NEXT}" -eq 1 ]; then
        SKIP_NEXT=0
        continue
    fi
    if [ "${ARG}" = "--retry-times" ]; then
        SKIP_NEXT=1
        continue
    fi
    NORMALIZED_ARGS+=("${ARG}")
done

echo "${NORMALIZED_ARGS[*]}" >> "${PARAMS_DATA_DIR}/mock_skopeo_calls"

if [ "${1}" = "inspect" ]; then
    LAST_ARG="${*: -1}"
    IMAGE_REF="${LAST_ARG#docker://}"

    if [ "${IMAGE_REF}" = "${_TEST_MANIFEST_LIST_OCI_REFERENCE}" ]; then
        cat <<'EOF'
{
  "schemaVersion": 2,
  "mediaType": "application/vnd.oci.image.index.v1+json",
  "manifests": [
    {"mediaType": "application/vnd.oci.image.manifest.v1+json", "digest": "sha256:0000-1"},
    {"mediaType": "application/vnd.oci.image.manifest.v1+json", "digest": "sha256:0000-2"},
    {"mediaType": "application/vnd.oci.image.manifest.v1+json", "digest": "sha256:0000-3"}
  ]
}
EOF
    elif [ "${IMAGE_REF}" = "${_TEST_MANIFEST_LIST_REFERENCE}" ]; then
        cat <<'EOF'
{
  "schemaVersion": 2,
  "mediaType": "application/vnd.docker.distribution.manifest.list.v2+json",
  "manifests": [
    {"mediaType": "application/vnd.docker.distribution.manifest.v2+json", "digest": "sha256:1111-1"},
    {"mediaType": "application/vnd.docker.distribution.manifest.v2+json", "digest": "sha256:1111-2"},
    {"mediaType": "application/vnd.docker.distribution.manifest.v2+json", "digest": "sha256:1111-3"}
  ]
}
EOF
    else
        echo '{"schemaVersion": 2, "mediaType": "application/vnd.docker.distribution.manifest.v2+json"}'
    fi
fi
